# Copy to supabase/mail.local.env (git-ignored) and fill in. Used by supabase/setup-email.sh.
SUPABASE_PROJECT_REF=your-project-ref
# Personal access token from https://supabase.com/dashboard/account/tokens (starts with sbp_)
SUPABASE_ACCESS_TOKEN=
SMTP_USER=you@gmail.com
# Gmail app password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASS=
MAIL_FROM_NAME=EcoFun
# Any long random string, e.g. `openssl rand -hex 32`. Must match mailer_secret in secrets.local.sql.
MAILER_SECRET=
