rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Password reset codes are managed only by trusted Cloud Functions.
    match /passwordResetCodes/{document} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'photoURL', 'points', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.points == 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'photoURL']);
      allow delete: if false;
    }

    match /communityPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update, delete: if false;
      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /quizAttempts/{attemptId} {
      allow read, write: if false;
    }
    match /pointGrants/{grantId} {
      allow read, write: if false;
    }
  }
}
